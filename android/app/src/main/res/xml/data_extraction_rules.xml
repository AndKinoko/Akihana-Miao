<?xml version="1.0" encoding="utf-8"?>
<!-- 备份/设备迁移规则：全部排除。
     应用持有网盘凭据与相机原图缓存，备份出去等于把凭据和用户照片
     复制到不受控的云端；且加密存储的密文换机后无法解密，备份也无意义。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
