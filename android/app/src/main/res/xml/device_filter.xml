<?xml version="1.0" encoding="utf-8"?>
<!-- USB 相机接入过滤器：
     class=6（Still Image/PTP）覆盖绝大多数相机的设备级声明；
     vendor-id 兜底覆盖把 class 声明在接口层的机型（尼康 1200=0x04B0，索尼 1356=0x054C） -->
<resources>
    <usb-device class="6" />
    <usb-device vendor-id="1200" />
    <usb-device vendor-id="1356" />
</resources>
